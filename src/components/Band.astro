---
/** Section header: the section label and title. The section's pattern lies faintly behind the whole page. */
import type { Section } from '../lib/sections';
interface Props { section: Section }
---
<header class="band">
  <div class="wrap band-text">
    <h1 class="band-title"><slot /></h1>
  </div>
  <slot name="after" />
</header>
