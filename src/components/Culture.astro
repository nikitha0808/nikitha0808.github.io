---
/**
 * Culture: a live Gray–Scott reaction–diffusion simulation on the GPU, painted like watercolour.
 * It grows (optionally from the letters of `text`), then rests. With `interactive`, press and drag
 * to feed it. Without WebGL2 it falls back to a still CSS pattern and the slot text.
 * The canvas is transparent where nothing grows; `strength` (0–1) sets how strongly the pigment shows.
 * `decorative` hides it from screen readers (used for the faint page backdrop).
 */
import { SPECIES, type SpeciesKey } from '../lib/species';
interface Props {
  species: SpeciesKey;
  text?: string;
  grow?: boolean;
  interactive?: boolean;
  readout?: boolean;
  class?: string;
  label?: string;
  strength?: number;
  decorative?: boolean;
  colors?: { ink: string; deep: string; wash: string }; // override the species' pigments, e.g. pale ones on dark
  steps?: number; // how long it grows at first (default: the species' own)
  density?: number; // starting seeds per 10,000 cells (default 11)
}
const { species, text, grow = false, interactive = false, readout = false, class: className = '', label, strength = 1, decorative = false, colors, steps, density } = Astro.props;
const s = SPECIES[species];
const description = label ?? `A ${s.name.toLowerCase()} pattern grown by reaction–diffusion${text ? ` from the letters “${text}”` : ''}.`;
---
<div
  class:list={['culture', !decorative && 'marks', className]}
  data-culture
  data-species={species}
  data-strength={strength}
  data-steps={steps}
  data-density={density}
  data-colors={colors ? JSON.stringify(colors) : undefined}
  data-text={text}
  data-grow={grow ? '' : undefined}
  data-interactive={interactive ? '' : undefined}
  style={`--ink:${s.ink}; --wash:${s.wash}`}
  role={decorative ? undefined : 'img'}
  aria-label={decorative ? undefined : description}
  aria-hidden={decorative ? 'true' : undefined}
>
  <canvas aria-hidden="true"></canvas>
  <div class="culture-fallback" aria-hidden="true"><slot /></div>
  {readout && (
    <p class="culture-readout mono" aria-hidden="true">
      Gray–Scott · f {s.f} · k {s.k} · step <span data-step>0</span>{interactive && <span class="culture-hint"> · press &amp; drag to feed it</span>}
    </p>
  )}
</div>

<script>
  import { SPECIES, type SpeciesKey } from '../lib/species';

  const VS = `#version 300 es
  in vec2 p; out vec2 uv;
  void main() { uv = p * .5 + .5; gl_Position = vec4(p, 0., 1.); }`;

  const SIM = `#version 300 es
  precision highp float;
  in vec2 uv; out vec4 o;
  uniform sampler2D s; uniform vec2 px; uniform float F, K, aspect; uniform vec3 brush;
  void main() {
    vec2 c = texture(s, uv).rg;
    vec2 l = -c
      + .2 * (texture(s, uv + vec2(px.x, 0.)).rg + texture(s, uv - vec2(px.x, 0.)).rg
            + texture(s, uv + vec2(0., px.y)).rg + texture(s, uv - vec2(0., px.y)).rg)
      + .05 * (texture(s, uv + px).rg + texture(s, uv - px).rg
             + texture(s, uv + vec2(px.x, -px.y)).rg + texture(s, uv + vec2(-px.x, px.y)).rg);
    float r = c.r * c.g * c.g;
    vec2 n = clamp(c + vec2(l.r - r + F * (1. - c.r), .5 * l.g + r - (F + K) * c.g), 0., 1.);
    if (brush.z > 0. && length((uv - brush.xy) * vec2(aspect, 1.)) < brush.z) n = vec2(.5, .25);
    o = vec4(n, 0., 1.);
  }`;

  // Watercolour: a faint wash ahead of the growth, a pigment body, and darker pigment pooled at the edges.
  // Output is premultiplied and transparent where nothing grows, so the page shows through.
  const PAINT = `#version 300 es
  precision highp float;
  in vec2 uv; out vec4 o;
  uniform sampler2D s; uniform vec2 px; uniform vec3 wash, ink, deep; uniform float strength;
  void main() {
    float v = texture(s, uv).g;
    float gx = texture(s, uv + vec2(px.x, 0.)).g - texture(s, uv - vec2(px.x, 0.)).g;
    float gy = texture(s, uv + vec2(0., px.y)).g - texture(s, uv - vec2(0., px.y)).g;
    float edge = clamp(length(vec2(gx, gy)) * 5., 0., 1.);
    float body = smoothstep(.10, .30, v) * .92;
    float halo = smoothstep(.012, .09, v);
    vec3 pig = mix(ink, deep, edge * .6);
    float g = fract(sin(dot(gl_FragCoord.xy, vec2(12.9898, 78.233))) * 43758.5453);
    vec3 rgb = pig * body + wash * halo * (1. - body);
    float a = body + halo * (1. - body);
    rgb += (g - .5) * .035 * a;
    o = vec4(rgb, a) * strength;
  }`;

  const hex = (h: string) => [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16) / 255);
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  function program(gl: WebGL2RenderingContext, fs: string) {
    const p = gl.createProgram()!;
    for (const [type, src] of [[gl.VERTEX_SHADER, VS], [gl.FRAGMENT_SHADER, fs]] as const) {
      const sh = gl.createShader(type)!;
      gl.shaderSource(sh, src);
      gl.compileShader(sh);
      gl.attachShader(p, sh);
    }
    gl.bindAttribLocation(p, 0, 'p');
    gl.linkProgram(p);
    if (!gl.getProgramParameter(p, gl.LINK_STATUS)) throw new Error(gl.getProgramInfoLog(p) ?? 'link failed');
    const u = (name: string) => gl.getUniformLocation(p, name);
    return { p, u };
  }

  async function seedData(W: number, H: number, text?: string, density = 11) {
    const data = new Float32Array(W * H * 4);
    let letterSize = 0;
    for (let i = 0; i < W * H; i++) data[i * 4] = 1;
    const put = (x: number, y: number) => {
      const i = ((H - 1 - y) * W + x) * 4; // GL rows run bottom-up
      data[i] = 0.5;
      data[i + 1] = 0.25 + Math.random() * 0.03;
    };
    if (text) {
      const font = (size: number) => `700 ${size}px "Fredoka", "Arial Rounded MT Bold", sans-serif`;
      await Promise.race([document.fonts.load(font(100)), new Promise((r) => setTimeout(r, 1500))]);
      const c = document.createElement('canvas');
      c.width = W; c.height = H;
      const x = c.getContext('2d')!;
      const lines = W / H < 2.4 && text.includes(' ') ? text.split(' ') : [text];
      x.font = font(100);
      const widest = Math.max(...lines.map((l) => x.measureText(l).width));
      const size = Math.min((100 * W * 0.9) / widest, (H * 0.78) / (lines.length * 0.82));
      letterSize = size;
      x.font = font(size);
      x.textAlign = 'center';
      x.textBaseline = 'middle';
      x.fillStyle = '#fff';
      lines.forEach((l, i) => x.fillText(l, W / 2, H / 2 + (i - (lines.length - 1) / 2) * size * 0.84));
      const px = x.getImageData(0, 0, W, H).data;
      for (let y = 0; y < H; y++) for (let xx = 0; xx < W; xx++) if (px[(y * W + xx) * 4 + 3] > 128) put(xx, y);
    } else {
      const count = Math.max(6, Math.round((W * H) * density / 10000));
      for (let n = 0; n < count; n++) {
        const cx = Math.floor(Math.random() * W), cy = Math.floor(Math.random() * H), r = 2 + Math.floor(Math.random() * 4);
        for (let y = cy - r; y <= cy + r; y++) for (let xx = cx - r; xx <= cx + r; xx++) if (xx >= 0 && y >= 0 && xx < W && y < H) put(xx, y);
      }
    }
    return { data, letterSize };
  }

  async function init(el: HTMLElement) {
    const canvas = el.querySelector('canvas')!;
    const gl = canvas.getContext('webgl2', { antialias: false, alpha: true, premultipliedAlpha: true });
    if (!gl || !gl.getExtension('EXT_color_buffer_float')) { el.classList.add('is-fallback'); return; }
    const sp = { ...SPECIES[el.dataset.species as SpeciesKey], ...(el.dataset.colors ? JSON.parse(el.dataset.colors) : {}) };
    const readout = el.querySelector<HTMLElement>('[data-step]');
    const interactive = el.hasAttribute('data-interactive');
    let animate = el.hasAttribute('data-grow') && !reduce;

    let sim, paint;
    try { sim = program(gl, SIM); paint = program(gl, PAINT); } catch { el.classList.add('is-fallback'); return; }
    const buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
    gl.enableVertexAttribArray(0);
    gl.vertexAttribPointer(0, 2, gl.FLOAT, false, 0, 0);

    let W = 0, H = 0, src = 0, done = 0, target = 0, raf = 0, running = false;
    let tex: WebGLTexture[] = [], fbs: WebGLFramebuffer[] = [];
    let brush: [number, number] | null = null;
    let brushR = 0; // brush radius in texture-height units (~14 CSS px)
    const strength = Number(el.dataset.strength ?? 1);

    async function build() {
      const rect = el.getBoundingClientRect();
      if (rect.width < 2 || rect.height < 2) return false;
      // Finer grid on small screens, so letters stay large relative to the pattern.
      const scale = rect.width < 700 ? 1.3 : 0.6;
      W = Math.round(rect.width * scale); H = Math.round(rect.height * scale);
      brushR = Math.min(0.45, 22 / rect.height);
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(rect.width * dpr); canvas.height = Math.round(rect.height * dpr);
      const { data, letterSize } = await seedData(W, H, el.dataset.text, Number(el.dataset.density) || 11);
      tex.forEach((t) => gl!.deleteTexture(t)); fbs.forEach((f) => gl!.deleteFramebuffer(f));
      tex = []; fbs = [];
      for (let i = 0; i < 2; i++) {
        const t = gl!.createTexture()!;
        gl!.bindTexture(gl!.TEXTURE_2D, t);
        gl!.texImage2D(gl!.TEXTURE_2D, 0, gl!.RGBA16F, W, H, 0, gl!.RGBA, gl!.FLOAT, i === 0 ? data : null);
        for (const [k, v] of [[gl!.TEXTURE_MIN_FILTER, gl!.LINEAR], [gl!.TEXTURE_MAG_FILTER, gl!.LINEAR], [gl!.TEXTURE_WRAP_S, gl!.CLAMP_TO_EDGE], [gl!.TEXTURE_WRAP_T, gl!.CLAMP_TO_EDGE]]) gl!.texParameteri(gl!.TEXTURE_2D, k, v);
        const fb = gl!.createFramebuffer()!;
        gl!.bindFramebuffer(gl!.FRAMEBUFFER, fb);
        gl!.framebufferTexture2D(gl!.FRAMEBUFFER, gl!.COLOR_ATTACHMENT0, gl!.TEXTURE_2D, t, 0);
        tex.push(t); fbs.push(fb);
      }
      // Smaller letters are swallowed sooner, so grow them for less long (tuned at ~150-cell letters).
      src = 0; done = 0; target = letterSize ? Math.round(sp.steps * Math.min(1, Math.max(0.3, letterSize / 150))) : (Number(el.dataset.steps) || sp.steps);
      return true;
    }

    function step(n: number) {
      gl!.useProgram(sim!.p);
      gl!.viewport(0, 0, W, H);
      gl!.uniform2f(sim!.u('px'), 1 / W, 1 / H);
      gl!.uniform1f(sim!.u('F'), sp.f);
      gl!.uniform1f(sim!.u('K'), sp.k);
      gl!.uniform1f(sim!.u('aspect'), W / H);
      gl!.uniform3f(sim!.u('brush'), brush ? brush[0] : 0, brush ? brush[1] : 0, brush ? brushR : 0);
      for (let i = 0; i < n; i++) {
        gl!.bindFramebuffer(gl!.FRAMEBUFFER, fbs[1 - src]);
        gl!.bindTexture(gl!.TEXTURE_2D, tex[src]);
        gl!.drawArrays(gl!.TRIANGLE_STRIP, 0, 4);
        src = 1 - src;
        done++;
      }
    }

    function draw() {
      gl!.bindFramebuffer(gl!.FRAMEBUFFER, null);
      gl!.viewport(0, 0, canvas.width, canvas.height);
      gl!.useProgram(paint!.p);
      gl!.uniform2f(paint!.u('px'), 1 / W, 1 / H);
      gl!.uniform1f(paint!.u('strength'), strength);
      gl!.uniform3f(paint!.u('wash'), ...(hex(sp.wash) as [number, number, number]));
      gl!.uniform3f(paint!.u('ink'), ...(hex(sp.ink) as [number, number, number]));
      gl!.uniform3f(paint!.u('deep'), ...(hex(sp.deep) as [number, number, number]));
      gl!.bindTexture(gl!.TEXTURE_2D, tex[src]);
      gl!.drawArrays(gl!.TRIANGLE_STRIP, 0, 4);
      if (readout) readout.textContent = String(done).padStart(4, '0');
    }

    function loop() {
      const per = animate ? 10 : 160; // animated growth, or grow out of sight and then appear
      const n = brush ? per : Math.min(per, target - done);
      if (n > 0) step(n);
      if (animate || done >= target) { draw(); el.classList.add('is-live'); }
      if (done < target || brush) raf = requestAnimationFrame(loop);
      else { running = false; animate = false; }
    }
    const start = () => { if (!running) { running = true; raf = requestAnimationFrame(loop); } };

    if (!(await build())) return;
    start();

    if (interactive) {
      const at = (e: PointerEvent): [number, number] => {
        const r = el.getBoundingClientRect();
        return [(e.clientX - r.left) / r.width, 1 - (e.clientY - r.top) / r.height];
      };
      let down = false;
      el.addEventListener('pointerdown', (e) => {
        down = true; brush = at(e); animate = true; target = Math.max(target, done) + 600; start();
        if (e.pointerType === 'touch') setTimeout(() => { if (!down) brush = null; }, 120);
      });
      el.addEventListener('pointermove', (e) => { if (down && e.pointerType !== 'touch') brush = at(e); });
      const up = () => { down = false; brush = null; };
      el.addEventListener('pointerup', up);
      el.addEventListener('pointerleave', up);
      el.addEventListener('pointercancel', up);
    }

    let lastWidth = el.getBoundingClientRect().width, timer = 0;
    new ResizeObserver(() => {
      const w = el.getBoundingClientRect().width;
      if (Math.abs(w - lastWidth) < 40) return;
      lastWidth = w;
      clearTimeout(timer);
      timer = window.setTimeout(async () => { cancelAnimationFrame(raf); running = false; animate = false; if (await build()) start(); }, 200);
    }).observe(el);
  }

  document.querySelectorAll<HTMLElement>('[data-culture]').forEach((el) => { init(el); });
</script>
