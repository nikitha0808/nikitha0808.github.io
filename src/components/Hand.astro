---
/**
 * Hand: shows Nikitha's own drawing or handwriting from src/assets/hand/<name>.(png|svg|webp)
 * if it exists, tinted to the current text colour. Otherwise renders the fallback in the slot.
 */
import type { ImageMetadata } from 'astro';
const files = import.meta.glob<{ default: ImageMetadata }>('/src/assets/hand/*.{png,svg,webp}', { eager: true });
interface Props { name: string; label?: string; class?: string }
const { name, label, class: className = '' } = Astro.props;
const found = Object.entries(files).find(([path]) => path.split('/').pop()!.replace(/\.[^.]+$/, '') === name)?.[1].default;
---
{found
  ? <span class:list={['hand', `hand-${name}`, className]} role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'} style={`--hand:url("${found.src}"); aspect-ratio:${found.width} / ${found.height}`}></span>
  : <slot />}
