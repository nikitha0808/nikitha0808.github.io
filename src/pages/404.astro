---
import Base from '../layouts/Base.astro';
import Culture from '../components/Culture.astro';
---
<Base title="Not found — Nikitha SR">
  <section class="hero">
    <h1 class="sr-only">404: not found</h1>
    <Culture species="spots" text="404" grow strength={0.85} class="hero-culture hero-culture--short"><span class="hero-fallback">404</span></Culture>
    <div class="wrap hero-foot">
      <p class="hero-intro">Nothing has grown at this address yet.</p>
      <p class="mono hero-fig"><a href="/">← Back to the beginning</a></p>
    </div>
  </section>
</Base>
