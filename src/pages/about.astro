---
import Base from '../layouts/Base.astro';
import Band from '../components/Band.astro';
import { existsSync } from 'node:fs';
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { SITE, sectionByKey, contactLinks } from '../lib/sections';
// Everything you write lives in src/content/about.md.
import { Content as AboutText, frontmatter as about } from '../content/about.md';
const s = sectionByKey.about;
// The questionnaire: answered questions are public; unanswered ones show (greyed) only on your machine.
type QA = { q: string; a?: string };
const questions = ((about.questions ?? []) as QA[])
  .map(({ q, a }) => ({ q, paras: String(a ?? '').trim().split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean) }))
  .filter((x) => x.q && (x.paras.length > 0 || import.meta.env.DEV));
const links = contactLinks(existsSync('public' + SITE.cv));
// Your photo: src/assets/portrait.jpg (or .png / .webp). Without one, the text stands alone.
const portrait = Object.values(import.meta.glob<{ default: ImageMetadata }>('/src/assets/portrait.{jpg,jpeg,png,webp,JPG,JPEG,PNG}', { eager: true }))[0]?.default;
const showPhoto = Boolean(portrait) || import.meta.env.DEV;
---
<Base title="About — Nikitha SR" stain="about">
  <Band section={s}>{about.title ?? 'About'}<em>.</em></Band>
  <div class:list={['wrap', 'record', !showPhoto && 'record--solo']}>
    {showPhoto && (
      <figure class="portrait">
        {portrait
          ? <Image src={portrait} alt={about.portraitAlt || 'Portrait of Nikitha'} widths={[360, 540, 720].filter((n) => n <= portrait.width)} sizes="(max-width: 820px) 70vw, 336px" loading="eager" />
          : <span class="portrait-empty mono">Your photo goes here<br />src/assets/portrait.jpg<br /><br />Only you see this</span>}
        {about.portraitCaption && <figcaption class="mono">{about.portraitCaption}</figcaption>}
      </figure>
    )}

    <div class="prose record-prose">
      <AboutText />
      {questions.length > 0 && (
        <section class="qa" aria-label={about.questionsTitle ?? 'A few questions'}>
          <h2>{about.questionsTitle ?? 'A few questions'}</h2>
          <dl>
            {questions.map(({ q, paras }) => (
              <div class:list={['qa-item', paras.length === 0 && 'is-unanswered']}>
                <dt>{q}</dt>
                <dd>{paras.length > 0 ? paras.map((p) => <p>{p}</p>) : <p class="mono">Unanswered, only you see this</p>}</dd>
              </div>
            ))}
          </dl>
        </section>
      )}
      <h2>Get in touch</h2>
      {links.length > 0 ? (
        <ul class="reg-links">{links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      ) : import.meta.env.DEV && <p class="hint">Add your email and LinkedIn in src/lib/sections.ts.</p>}
    </div>

  </div>
</Base>
