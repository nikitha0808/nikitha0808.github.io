---
import Base from '../layouts/Base.astro';
import Denoise from '../components/Denoise.astro';
import { getArtworks } from '../lib/art';

const artworks = await getArtworks();
---
<Base footPattern={false} footnote="The painting above is of me, by me, made with watercolour brushes on a digital canvas. It arrives the way images from the generative models I study do: one step at a time, out of noise.">
  <section class="hero2">
    <Denoise works={artworks} pick="2021-07-what-is-it-that-im-running-for" class="hero2-art" />
    <div class="wrap hero2-inner">
      <div class="hero2-text">
        <p class="mono hero2-kicker">Computer vision research · Digital painting</p>
        <h1 class="hero2-title">A jar of my curiosity and creations.</h1>
        <p class="hero2-lead">I'm Nikitha, a researcher and digital artist based in Bangalore. These days I work on image generation.</p>
      </div>
    </div>
  </section>
</Base>
